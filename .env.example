# Copied to .env at the repository root (harness.run / harness.serve / harness.launcher load it).
# Only the providers you launch with are needed: --model openai:<model> uses OPENAI_API_KEY,
# --model openrouter:<vendor>/<model> uses OPENROUTER_API_KEY. Every model must also have a
# row in configs/model_costs.yaml (and, for web episodes, configs/model_limits.yaml).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
